#version 450

#include "dequant_head.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_rocmiq1_s data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

void main() {
    init_iq_shmem(gl_WorkGroupSize);

    const uint ib = gl_WorkGroupID.x * 16 + gl_LocalInvocationID.x / 16;
    if (ib >= p.nel / 256) {
        return;
    }

    const uint w = 16 * (gl_LocalInvocationID.x % 16);
    const uint b_idx = 256 * ib + w;
    const float d = rocmiq_sub_scale(uint(data_a[ib].sc), w >> 6u) * 0.03125;

    [[unroll]] for (uint k = 0; k < 4; ++k) {
        const uint i = (w >> 2u) + k;
        const uint ci = ((uint(data_a[ib].ql[i >> 1u]) >> (4u * (i & 1u))) & 15u) |
                        (((uint(data_a[ib].qh[i >> 2u]) >> (2u * (i & 3u))) & 3u) << 4u);
        const vec4 q = rocmiq1_cb4(ci);
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            data_b[b_idx + 4u * k + j] = D_TYPE(q[j] * d);
        }
    }
}
