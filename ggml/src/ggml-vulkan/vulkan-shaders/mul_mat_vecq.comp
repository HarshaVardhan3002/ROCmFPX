#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require

#define MMQ
#define NEEDS_IQ1S_GRID_GPU
#define KVALUES_IQ4NL_I8
#define B_TYPE block_q8_1_x4

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#if defined(DATA_A_Q2_0) || defined(DATA_A_QUANT_K) || defined(DATA_A_ROCMFP4)
#define K_PER_ITER 16
#elif defined(DATA_A_QUANT_LEGACY) || defined(DATA_A_MXFP4) || defined(DATA_A_ROCMFP4_FAST)
#define K_PER_ITER 8
#elif defined(DATA_A_IQ1_S) || defined(DATA_A_IQ1_M) || defined(DATA_A_IQ4_XS)
#define K_PER_ITER 32
#else
#error unimplemented
#endif

// ROCmFP4 runs faster without manual unrolling (fewer registers, more waves in flight)
#if defined(DATA_A_ROCMFP4)
#define UNROLL 1
#else
#define UNROLL 4
#endif

uint a_offset, b_offset, d_offset;

int32_t cache_b_qs[K_PER_ITER / 4];
vec2 cache_b_ds;

#include "mul_mat_vecq_funcs.glsl"

// q8_1 blocks per iteration of the column loop
const uint BLK_STRIDE = K_PER_ITER * BLOCK_SIZE / QUANT_K_Q8_1;

// Block index (in QUANT_K_Q8_1 units) of this thread's first column, per row of A
// and per column of B. Iteration it reads block idx + it * BLK_STRIDE, so addresses
// step by a constant instead of being divided out again for every block.
uint a_row_blk[NUM_ROWS];
uint b_col_blk[NUM_COLS];

void iter(inout FLOAT_TYPE temp[NUM_COLS][NUM_ROWS], const uint num_rows, const uint it, const uint b_qs_idx) {
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        // Preload data_b block
        uint b_block_idx_outer, b_block_idx_inner;
        if (BLK_STRIDE % 4 == 0) {
            // the position inside the x4 block stays the same
            b_block_idx_outer = b_col_blk[j] / 4 + it * (BLK_STRIDE / 4);
            b_block_idx_inner = b_col_blk[j] % 4;
        } else {
            const uint b_block_idx = b_col_blk[j] + it * BLK_STRIDE;
            b_block_idx_outer = b_block_idx / 4;
            b_block_idx_inner = b_block_idx % 4;
        }
        cache_b_ds = vec2(data_b[b_block_idx_outer].ds[b_block_idx_inner]);

#if QUANT_R == 2
#if K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx + 4];
#elif K_PER_ITER == 16
        // values 8*b_qs_idx..+7 and the same values + 16
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 4];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 5];
#else
#error unimplemented
#endif
#else
#if K_PER_ITER == 8
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 2 + 1];
#elif K_PER_ITER == 16
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + b_qs_idx * 4 + 3];
#elif K_PER_ITER == 32
        cache_b_qs[0] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8    ];
        cache_b_qs[1] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 1];
        cache_b_qs[2] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 2];
        cache_b_qs[3] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 3];
        cache_b_qs[4] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 4];
        cache_b_qs[5] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 5];
        cache_b_qs[6] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 6];
        cache_b_qs[7] = data_b[b_block_idx_outer].qs[b_block_idx_inner * 8 + 7];
#else
#error unimplemented
#endif
#endif

        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] += mmvq_dot_product(a_row_blk[n] + it * BLK_STRIDE, b_qs_idx);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    const uint tid = gl_LocalInvocationID.x;

    get_offsets(a_offset, b_offset, d_offset);
    a_offset *= QUANT_K / QUANT_K_Q8_1;
    b_offset /= QUANT_K_Q8_1;

    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint n = 0; n < num_rows; ++n) {
            temp[j][n] = FLOAT_TYPE(0.0f);
        }
    }

    const uint col_stride = K_PER_ITER * BLOCK_SIZE;
    uint num_iters = p.ncols / col_stride;
    if (num_iters * col_stride + K_PER_ITER * tid < p.ncols) {
        num_iters++;
    }

    // ncols and the B column stride are multiples of QUANT_K_Q8_1
    const uint tid_blk = (tid * K_PER_ITER) / QUANT_K_Q8_1;
    [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
        a_row_blk[n] = (first_row + n) * (p.ncols / QUANT_K_Q8_1) + a_offset + tid_blk;
    }
    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        b_col_blk[j] = j * (p.batch_stride_b / QUANT_K_Q8_1) + b_offset + tid_blk;
    }

    const uint b_qs_idx = tid % (32 / K_PER_ITER);
    uint it = 0;
    while (num_iters >= UNROLL) {
        // Manually partially unroll the loop
        [[unroll]] for (uint k = 0; k < UNROLL; ++k) {
            iter(temp, num_rows, it + k, b_qs_idx);
        }
        it += UNROLL;
        num_iters -= UNROLL;
    }

    if (UNROLL > 2 && num_iters >= 2) {
        // Manually partially unroll the loop
        iter(temp, num_rows, it, b_qs_idx);
        iter(temp, num_rows, it + 1, b_qs_idx);
        it += 2;
        num_iters -= 2;
    }

    if (UNROLL > 1 && num_iters > 0) {
        iter(temp, num_rows, it, b_qs_idx);
    }

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
